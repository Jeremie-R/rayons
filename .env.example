# Copy to .env.local. Leave everything empty to run the demo (made-up mail, events and projects, kept in this browser).

# --- Browser (public, built into the JavaScript) ---
# Supabase → Project Settings → API Keys. The publishable key is safe in the browser (row-level security protects the data).
VITE_SUPABASE_URL=
VITE_SUPABASE_KEY=
# Google Cloud → Google Auth Platform → Clients → the "Rayons web" client ID. Public by nature.
VITE_GOOGLE_CLIENT_ID=

# --- Server only (api/ functions). Never give these a VITE_ name. ---
SUPABASE_URL=
# Supabase → Project Settings → API Keys → secret key (sb_secret_…) or the legacy service_role key.
SUPABASE_SECRET_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 32 random bytes, base64. Encrypts the Google tokens kept in the database. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=
